---
import "../styles/global.css";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import logo from "../assets/images/logo-jardins-dici.png";

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const site = (await getEntry("site", "main"))!.data;
const fullTitle = title === "Accueil" ? "Aux Jardins d’ici — Naninne" : `${title} · Aux Jardins d’ici`;
const metaDescription = description ?? site.tagline;
const path = Astro.url.pathname;

const nav = [
  { href: "/projet", label: "Le projet" },
  { href: "/espaces", label: "Les espaces" },
  { href: "/ecole", label: "École" },
  { href: "/agenda", label: "Agenda" },
  { href: "/benevolat", label: "S’impliquer" },
  { href: "/infos-pratiques", label: "Infos pratiques" },
];
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta name="theme-color" content="#1d3a2a" />
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="top">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="Aux Jardins d’ici — accueil">
          <Image src={logo} alt="" width={84} height={56} loading="eager" />
          <span class="brand-name">Aux Jardins <em>d’ici</em></span>
        </a>
        <button class="burger" type="button" aria-expanded="false" aria-controls="nav" aria-label="Ouvrir le menu"><span></span><span></span><span></span></button>
          <nav id="nav" class="menu" aria-label="Navigation principale">
            <ul>
              {nav.map((n) => (
                <li><a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a></li>
              ))}
            </ul>
          </nav>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="foot">
      <svg class="wave" viewBox="0 0 1200 28" preserveAspectRatio="none" aria-hidden="true"><path d="M0 14 C 100 2, 200 26, 300 14 S 500 2, 600 14 S 800 26, 900 14 S 1100 2, 1200 14" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      <div class="wrap foot-grid">
        <div class="foot-cta">
          <p class="hand">Pour ne rien rater des prochains rendez-vous…</p>
          <div class="foot-actions">
            <a class="btn" href={site.newsletterUrl}>S’inscrire à la newsletter</a>
            <a class="btn ghost" href={site.facebookUrl}>Nous suivre sur Facebook</a>
          </div>
        </div>
        <div>
          <h4>Nous trouver</h4>
          <p>{site.address}<br /><a href={site.mapsUrl}>Itinéraire</a> · <a href="/infos-pratiques">Accès</a></p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <h4>Explorer</h4>
          <ul class="foot-links">
            <li><a href="/le-saviez-vous">Le saviez-vous ?</a></li>
            <li><a href="/faq">Questions fréquentes</a></li>
            <li><a href="/galerie">Galerie photo</a></li>
            <li><a href="/ressources">Ressources</a></li>
            <li><a href="/projet/odd">Les Jardins d’ici et les ODD</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap foot-small">
        <span>Un projet de Relocalise, Semisto, Natagora Cœur de Wallonie et du magasin <em>d’ici</em>.</span>
        <span>Site réalisé par <a href="https://supergenial.be">Super Génial</a></span>
      </div>
    </footer>
    <script>
      const b = document.querySelector(".burger");
      b?.addEventListener("click", () => {
        const open = b.getAttribute("aria-expanded") === "true";
        b.setAttribute("aria-expanded", String(!open));
        b.setAttribute("aria-label", open ? "Ouvrir le menu" : "Fermer le menu");
        document.documentElement.classList.toggle("nav-open", !open);
      });
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 72px; }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--ink); }
  .brand img { width: 64px; height: auto; }
  .brand-name { font-family: var(--font-display); font-size: 1.3rem; line-height: 1; }
  .brand-name em { font-style: normal; color: var(--apple); }

  .burger { display: none; }
  .menu ul { display: flex; gap: 0.2rem; list-style: none; margin: 0; padding: 0; }
  .menu a {
    display: block; padding: 0.45em 0.8em; border-radius: 999px;
    color: var(--ink); text-decoration: none; font-weight: 550;
  }
  .menu a:hover { background: var(--paper-deep); color: var(--ink); }
  .menu a[aria-current="page"] { background: var(--ink); color: var(--paper); }

  @media (max-width: 960px) {
    .bar { flex-wrap: wrap; }
    .menu { flex-basis: 100%; padding-bottom: 0.8rem; }
    .menu ul { flex-wrap: wrap; }
    :global(html.js) .burger {
      display: grid; gap: 5px; padding: 12px 10px; border: 0; border-radius: 10px;
      background: var(--ink); cursor: pointer;
    }
    .burger span { display: block; width: 22px; height: 2px; background: var(--paper); border-radius: 2px; }
    :global(html.js:not(.nav-open)) .menu { display: none; }
    :global(html.js) .menu ul { flex-direction: column; }
    :global(html.js) .menu a { font-size: 1.15rem; padding: 0.65em 0.9em; }
    .brand-name { font-size: 1.1rem; }
    .brand img { width: 52px; }
  }

  .foot { margin-top: 6rem; padding-bottom: 2rem; background: var(--paper-deep); }
  .foot .wave { color: var(--paper); background: var(--paper-deep); transform: translateY(-1px) scaleY(-1); }
  .foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 2.5rem; padding-top: 2.5rem; }
  .foot-cta .hand { font-size: 2rem; margin-bottom: 1rem; }
  .foot-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .foot h4 { font-size: 1.1rem; }
  .foot p { margin-bottom: 0.6em; }
  .foot-links { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
  .foot-small {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem;
    margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--line);
    font-size: 0.9rem; color: var(--ink-soft);
  }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
