---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { getTextes } from "../lib/textes";
const T = (await getTextes()).page_introuvable;
---

<Base title={T.titre}>
  <PageHeader title={T.titre} description={T.description} kicker={T.surtitre} />
  <p class="narrow"><a class="btn" href="/">{T.retour}</a></p>
</Base>
