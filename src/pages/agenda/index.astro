---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import EventCard from "../../components/EventCard.astro";
import { eventsSplit } from "../../lib/content";
import { getTextes } from "../../lib/textes";


const { upcoming, past } = await eventsSplit();
const T = (await getTextes()).agenda;
---

<Base title={T.titre_onglet} description={T.description}>
  <PageHeader title={T.titre} description={T.description} kicker={T.surtitre} />
  <section class="wrap">
    <h2>{T.a_venir}</h2>
    {upcoming.length ? (
      <div class="list">{upcoming.map((e) => <EventCard event={e} />)}</div>
    ) : (
      <p class="empty">{T.aucun}</p>
    )}
  </section>
  <section class="wrap past">
    <h2>{T.passes}</h2>
    <div class="list">{past.map((e) => <EventCard event={e} past />)}</div>
  </section>
</Base>

<style>
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 1.5rem; }
  .past { margin-top: 4rem; }
  .empty { color: var(--ink-soft); }
</style>
