{
  // Admin conversationnelle : Worker séparé, sur son propre domaine, protégé par Cloudflare Access.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jardinsdici-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.md"], "fallthrough": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "jardinsdici-admin", "database_id": "76c06980-a010-434f-8cfd-a59b946a522e", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "RUNNER", "class_name": "ConversationRunner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationRunner"] }],
  "vars": {
    "GITHUB_REPO": "semisto-org/jardinsdici",
    "SITE_URL": "https://jardinsdici.birch.workers.dev",
    "PREVIEW_URL_TEMPLATE": "https://{alias}-jardinsdici.birch.workers.dev",
    "ADMIN_EMAILS": "m.hulet@semisto.org,ines.riou@student.unamur.be",
    "ADMIN_NAMES": "m.hulet@semisto.org=Michael Hulet,ines.riou@student.unamur.be=Inès Riou",
    "COMMIT_EMAIL": "bonjour@jardinsdici.org",
    "MODEL": "claude-opus-5"
    // ACCESS_TEAM_DOMAIN et ACCESS_AUD : ajoutés une fois l'application Cloudflare Access créée.
    // Secrets (wrangler secret put -c wrangler.admin.jsonc) : ANTHROPIC_API_KEY, GITHUB_TOKEN.
  }
}
