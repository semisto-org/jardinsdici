{
  // Admin conversationnelle : Worker séparé, sur son propre domaine, protégé par Cloudflare Access.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jardinsdici-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.jardinsdici.org", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.md"], "fallthrough": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "jardinsdici-admin", "database_id": "af47d289-22e3-4c7a-a5ea-e88b72322e72", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "RUNNER", "class_name": "ConversationRunner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationRunner"] }],
  "vars": {
    "GITHUB_REPO": "semisto-org/jardinsdici",
    "SITE_URL": "https://www.jardinsdici.org",
    "PREVIEW_URL_TEMPLATE": "https://{alias}-jardinsdici.semisto.workers.dev",
    "ADMIN_EMAILS": "m.hulet@semisto.org,ines.riou@student.unamur.be",
    "ADMIN_NAMES": "m.hulet@semisto.org=Michael Hulet,ines.riou@student.unamur.be=Inès Riou",
    "COMMIT_EMAIL": "bonjour@jardinsdici.org",
    "MODEL": "claude-opus-5-5",
    // Cloudflare Access (application « jardinsdici-admin », tout le trafic, e-mails autorisés + code par e-mail)
    "ACCESS_TEAM_DOMAIN": "semisto.cloudflareaccess.com",
    "ACCESS_AUD": "9b1f187b19c23e89f0a7da4db289ed4ccad61c978475c23a428b0fe002111c58"
    // Secrets (wrangler secret put -c wrangler.admin.jsonc) : ANTHROPIC_API_KEY, GITHUB_TOKEN.
  }
}
